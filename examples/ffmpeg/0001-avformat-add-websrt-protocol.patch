+/**
+ * @file
+ * WebSRT (SRT over WebTransport) protocol via libwebsrt
+ *
+ * URL syntax: websrt://host:port[?options]
+ *
+ *   stream=NAME          stream name (required)
+ *   cert_hash=HEX        SHA-256 of the gateway cert DER (64 hex chars);
+ *                        pins the certificate the way browsers pin
+ *                        self-signed WebTransport gateways
+ *   pki=1                normal PKI validation (default when no cert
+ *                        parameter is given)
+ *   latency_ms=N         TSBPD latency floor (default 120)
+ *
+ * Direction decides semantics: an OUTPUT (AVIO_FLAG_WRITE) publishes
+ * the stream name toward the gateway; an INPUT subscribes to it. The
+ * same URL works verbatim as ffmpeg output and input.
+ *
+ * The protocol carries MPEG-TS bytes: the library frames them into
+ * 188-aligned SRT live messages of at most 1128 bytes (6 TS packets,
+ * the WebSRT payload constant). Writes accept any buffer size (a
+ * partial accept resumes from data + returned); reads deliver one
+ * message at a time through an internal bounce buffer, so callers may
+ * use any buffer size >= 1 (ffmpeg's AVIO buffers are far larger than
+ * one message).
+ *
+ * All calls block on the library's session thread; a stalled peer
+ * bounds url_write to 30 s and a dataless url_read to 15 s before
+ * failing, so a dead gateway cannot hang ffmpeg forever.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/error.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/parseutils.h"
+#include "libavutil/time.h"
+
+#include "avformat.h"
+#include "url.h"
+
+#include "websrt/websrt_c.h"
+
+/* WebSRT payload constant: 6 x 188-byte TS packets (see websrt-cpp). */
+#define WEBSRT_PAYLOAD_SIZE 1128
+
+/* Retry window for subscribing to a stream whose publisher has not
+ * registered the name yet (live-edge join during broadcast startup).
+ * Attempts use the library's default connect timeout (10 s) - cutting
+ * it short abandons in-flight QUIC handshakes server-side, which the
+ * local oracle punishes with longer accept stalls. */
+#define WEBSRT_OPEN_RETRY_MS 20000
+#define WEBSRT_OPEN_RETRY_DELAY_US 500000
+
+/* Per-call budgets: publisher writes block under SRT backpressure
+ * (timeout below), reads poll; both get an overall stall bound. */
+#define WEBSRT_IO_TIMEOUT_MS 1000
+#define WEBSRT_WRITE_BUDGET_US 30000000
+#define WEBSRT_READ_STALL_US 15000000
+#define WEBSRT_END_TIMEOUT_MS 5000
+
+/* Periodic stats line interval (AV_LOG_DEBUG). */
+#define WEBSRT_STATS_INTERVAL_US 5000000
+
+typedef struct WebSRTContext {
+    websrt_publisher_t  *pub;
+    websrt_subscriber_t *sub;
+    int                  is_output;
+
+    /* Parsed URL state. */
+    char                 cert_hash[2 * 32 + 1]; /* "" = PKI */
+    int                  latency_ms;
+
+    /* Read bounce: one SRT message at a time, served to any caller
+     * buffer size. */
+    uint8_t              bounce[WEBSRT_PAYLOAD_SIZE];
+    int                  bounce_len;
+    int                  bounce_off;
+
+    int64_t              bytes_in;
+    int64_t              bytes_out;
+    int64_t              last_stats_us;
+} WebSRTContext;
+
+static int websrt_is_hex_64(const char *s)
+{
+    int i;
+    for (i = 0; i < 64; i++) {
+        if (!av_isxdigit(s[i]))
+            return 0;
+    }
+    return s[64] == '\0';
+}
+
+static int websrt_parse_options(URLContext *h, const char *uri,
+                                char *host, int host_size, int *port,
+                                char *stream, int stream_size,
+                                WebSRTContext *s)
+{
+    const char *p;
+    char buf[1024];
+    int cert_params = 0;
+
+    av_url_split(NULL, 0, NULL, 0, host, host_size, port, NULL, 0, uri);
+    if (!host[0]) {
+        av_log(h, AV_LOG_ERROR, "host missing in '%s'\n", uri);
+        return AVERROR(EINVAL);
+    }
+    if (*port < 0)
+        *port = 443; /* the WebSRT gateway default */
+
+    stream[0] = '\0';
+    s->cert_hash[0] = '\0';
+    s->latency_ms = 0; /* 0 = library default (120) */
+
+    p = strchr(uri, '?');
+    if (!p) {
+        av_log(h, AV_LOG_ERROR, "no options: stream name required (%s)\n", uri);
+        return AVERROR(EINVAL);
+    }
+    if (av_find_info_tag(buf, sizeof(buf), "stream", p)) {
+        av_strlcpy(stream, buf, stream_size);
+    }
+    if (av_find_info_tag(buf, sizeof(buf), "cert_hash", p)) {
+        if (!websrt_is_hex_64(buf)) {
+            av_log(h, AV_LOG_ERROR, "cert_hash must be 64 hex characters\n");
+            return AVERROR(EINVAL);
+        }
+        av_strlcpy(s->cert_hash, buf, sizeof(s->cert_hash));
+        cert_params++;
+    }
+    if (av_find_info_tag(buf, sizeof(buf), "pki", p)) {
+        if (cert_params) {
+            av_log(h, AV_LOG_ERROR, "cert_hash and pki are mutually exclusive\n");
+            return AVERROR(EINVAL);
+        }
+        cert_params++;
+    }
+    if (av_find_info_tag(buf, sizeof(buf), "latency_ms", p)) {
+        char *end;
+        long latency = strtol(buf, &end, 10);
+        if (*end != '\0' || latency <= 0 || latency > 86400000) {
+            av_log(h, AV_LOG_ERROR, "latency_ms must be a positive integer <= 86400000\n");
+            return AVERROR(EINVAL);
+        }
+        s->latency_ms = (int)latency;
+    }
+
+    if (!stream[0]) {
+        av_log(h, AV_LOG_ERROR, "stream name required (?stream=NAME)\n");
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+static void websrt_log_stats(URLContext *h, WebSRTContext *s, int force)
+{
+    int64_t now = av_gettime();
+    char stats[512];
+
+    if (!force && now - s->last_stats_us < WEBSRT_STATS_INTERVAL_US)
+        return;
+    s->last_stats_us = now;
+
+    if (s->is_output) {
+        if (websrt_publisher_stats(s->pub, stats, sizeof(stats)) == WEBSRT_OK)
+            av_log(h, AV_LOG_DEBUG, "stats: %s\n", stats);
+    } else {
+        if (websrt_subscriber_stats(s->sub, stats, sizeof(stats)) == WEBSRT_OK)
+            av_log(h, AV_LOG_DEBUG, "stats: %s\n", stats);
+    }
+}
+
+static int websrt_open(URLContext *h, const char *uri, int flags)
+{
+    WebSRTContext *s = h->priv_data;
+    char host[1024], stream[1024];
+    int port, ret;
+    websrt_status_t st;
+
+    h->is_streamed = 1;
+    s->is_output   = (flags & AVIO_FLAG_WRITE) != 0;
+
+    ret = websrt_parse_options(h, uri, host, sizeof(host), &port,
+                               stream, sizeof(stream), s);
+    if (ret < 0)
+        return ret;
+
+    if (s->is_output) {
+        /* Direction decides semantics: output publishes the name. One
+         * retry after a transport-level stall: the gateway's accept
+         * loop can starve transiently under churn (self-healing). */
+        int attempt;
+        for (attempt = 0;; attempt++) {
+            s->pub = websrt_publisher_create();
+            if (!s->pub)
+                return AVERROR(ENOMEM);
+            st = websrt_publisher_start(s->pub, host, port, stream,
+                                        s->cert_hash[0] ? s->cert_hash : NULL,
+                                        s->latency_ms, 0);
+            if (st == WEBSRT_OK)
+                break;
+            if ((st == WEBSRT_ETIMEOUT || st == WEBSRT_ECONNECT) && attempt == 0) {
+                av_log(h, AV_LOG_WARNING, "publish start stalled (%s); retrying in 3 s\n",
+                       websrt_publisher_last_error(s->pub));
+                websrt_publisher_destroy(s->pub);
+                s->pub = NULL;
+                av_usleep(3000000);
+                continue;
+            }
+            {
+                const char *why = websrt_publisher_last_error(s->pub);
+                if (st == WEBSRT_EREJECTED) {
+                    av_log(h, AV_LOG_ERROR, "stream name in use: '%s' is held by a live source\n", stream);
+                    ret = AVERROR(EADDRINUSE);
+                } else if (st == WEBSRT_ETIMEOUT) {
+                    ret = AVERROR(ETIMEDOUT);
+                } else {
+                    ret = AVERROR(EIO);
+                }
+                av_log(h, AV_LOG_ERROR, "publish start failed: %s\n", why);
+                websrt_publisher_destroy(s->pub);
+                s->pub = NULL;
+                return ret;
+            }
+        }
+        av_log(h, AV_LOG_INFO, "publishing '%s' to %s:%d (%s)\n",
+               stream, host, port, s->cert_hash[0] ? "cert pinned" : "PKI");
+    } else {
+        /* Input subscribes; retry while the gateway answers 404 so a
+         * live-edge join during broadcast startup succeeds, and ride
+         * out transient transport stalls the same way - but a stream
+         * that never appears fails within the retry window. */
+        int64_t deadline = av_gettime() + WEBSRT_OPEN_RETRY_MS * 1000LL;
+        for (;;) {
+            s->sub = websrt_subscriber_create();
+            if (!s->sub)
+                return AVERROR(ENOMEM);
+            st = websrt_subscriber_start(s->sub, host, port, stream,
+                                         s->cert_hash[0] ? s->cert_hash : NULL,
+                                         s->latency_ms, 0);
+            if (st == WEBSRT_OK)
+                break;
+            if (st == WEBSRT_EREJECTED || st == WEBSRT_ETIMEOUT || st == WEBSRT_ECONNECT) {
+                websrt_subscriber_destroy(s->sub);
+                s->sub = NULL;
+                if (av_gettime() >= deadline) {
+                    av_log(h, AV_LOG_ERROR, "stream '%s' not available: %s\n",
+                           stream, st == WEBSRT_EREJECTED
+                                      ? "no publisher (HTTP 404)" : "gateway unreachable");
+                    return AVERROR(ECONNREFUSED);
+                }
+                av_usleep(WEBSRT_OPEN_RETRY_DELAY_US);
+                continue;
+            }
+            av_log(h, AV_LOG_ERROR, "subscribe start failed: %s\n",
+                   websrt_subscriber_last_error(s->sub));
+            websrt_subscriber_destroy(s->sub);
+            s->sub = NULL;
+            return st == WEBSRT_ETIMEOUT ? AVERROR(ETIMEDOUT) : AVERROR(EIO);
+        }
+        av_log(h, AV_LOG_INFO, "subscribed to '%s' at %s:%d (%s)\n",
+               stream, host, port, s->cert_hash[0] ? "cert pinned" : "PKI");
+    }
+    s->last_stats_us = av_gettime();
+    return 0;
+}
+
+static int websrt_read(URLContext *h, uint8_t *buf, int size)
+{
+    WebSRTContext *s = h->priv_data;
+    int64_t stall_deadline = av_gettime() + WEBSRT_READ_STALL_US;
+
+    /* Serve a short read from the bounce buffer first. */
+    if (s->bounce_off < s->bounce_len) {
+        int n = FFMIN(size, s->bounce_len - s->bounce_off);
+        memcpy(buf, s->bounce + s->bounce_off, n);
+        s->bounce_off += n;
+        if (s->bounce_off == s->bounce_len)
+            s->bounce_off = s->bounce_len = 0;
+        s->bytes_in += n;
+        websrt_log_stats(h, s, 0);
+        return n;
+    }
+
+    for (;;) {
+        int n = websrt_subscriber_read(s->sub, s->bounce, sizeof(s->bounce),
+                                       WEBSRT_IO_TIMEOUT_MS);
+        if (n > 0) {
+            int m = FFMIN(size, n);
+            memcpy(buf, s->bounce, m);
+            s->bounce_len = n;
+            s->bounce_off = m;
+            s->bytes_in  += m;
+            websrt_log_stats(h, s, 0);
+            return m;
+        }
+        switch (n) {
+        case WEBSRT_READ_TIMEOUT:
+            if (av_gettime() >= stall_deadline) {
+                av_log(h, AV_LOG_ERROR, "no data for %d ms\n",
+                       (int)(WEBSRT_READ_STALL_US / 1000));
+                return AVERROR(ETIMEDOUT);
+            }
+            continue;
+        case WEBSRT_READ_END:
+            return AVERROR_EOF;
+        case WEBSRT_READ_CLOSED:
+            av_log(h, AV_LOG_ERROR, "session closed: %s\n",
+                   websrt_subscriber_last_error(s->sub));
+            return AVERROR(ECONNRESET);
+        default:
+            av_log(h, AV_LOG_ERROR, "read failed: %s\n",
+                   websrt_subscriber_last_error(s->sub));
+            return AVERROR(EIO);
+        }
+    }
+}
+
+static int websrt_write(URLContext *h, const uint8_t *buf, int size)
+{
+    WebSRTContext *s = h->priv_data;
+    const uint8_t *data = buf;
+    int left = size;
+    int64_t budget_deadline = av_gettime() + WEBSRT_WRITE_BUDGET_US;
+
+    while (left > 0) {
+        int n = websrt_publisher_write(s->pub, data, left, WEBSRT_IO_TIMEOUT_MS);
+        if (n > 0) {
+            /* Partial accept: resume from data + returned. */
+            data += n;
+            left -= n;
+            s->bytes_out += n;
+            websrt_log_stats(h, s, 0);
+            continue;
+        }
+        switch (n) {
+        case WEBSRT_WRITE_TIMEOUT:
+            if (av_gettime() >= budget_deadline) {
+                av_log(h, AV_LOG_ERROR, "write stalled for %d ms (backpressure)\n",
+                       (int)(WEBSRT_WRITE_BUDGET_US / 1000));
+                return AVERROR(ETIMEDOUT);
+            }
+            continue;
+        case WEBSRT_WRITE_CLOSED:
+            av_log(h, AV_LOG_ERROR, "session closed: %s\n",
+                   websrt_publisher_last_error(s->pub));
+            return AVERROR(EPIPE);
+        default:
+            av_log(h, AV_LOG_ERROR, "write failed: %s\n",
+                   websrt_publisher_last_error(s->pub));
+            return AVERROR(EIO);
+        }
+    }
+    return size;
+}
+
+static int websrt_close(URLContext *h)
+{
+    WebSRTContext *s = h->priv_data;
+
+    if (s->pub) {
+        websrt_status_t st = websrt_publisher_end(s->pub, WEBSRT_END_TIMEOUT_MS);
+        if (st != WEBSRT_OK) {
+            av_log(h, AV_LOG_WARNING, "graceful end failed (%s); dropping tail\n",
+                   websrt_publisher_last_error(s->pub));
+            websrt_publisher_stop(s->pub);
+        }
+        websrt_log_stats(h, s, 1);
+        av_log(h, AV_LOG_INFO, "stopped publishing: %lld bytes written\n",
+               (long long)s->bytes_out);
+        websrt_publisher_destroy(s->pub);
+        s->pub = NULL;
+    }
+    if (s->sub) {
+        websrt_log_stats(h, s, 1);
+        av_log(h, AV_LOG_INFO, "stopped subscribing: %lld bytes read\n",
+               (long long)s->bytes_in);
+        websrt_subscriber_destroy(s->sub);
+        s->sub = NULL;
+    }
+    return 0;
+}
+
+const URLProtocol ff_websrt_protocol = {
+    .name                = "websrt",
+    .url_open            = websrt_open,
+    .url_read            = websrt_read,
+    .url_write           = websrt_write,
+    .url_close           = websrt_close,
+    .priv_data_size      = sizeof(WebSRTContext),
+    .flags               = URL_PROTOCOL_FLAG_NETWORK,
+};
-- 
