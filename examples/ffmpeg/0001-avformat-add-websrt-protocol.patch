 libavformat/Makefile      |   1 +
 libavformat/protocols.c   |   1 +
 libavformat/websrtproto.c | 483 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 490 insertions(+)
 create mode 100644 libavformat/websrtproto.c

