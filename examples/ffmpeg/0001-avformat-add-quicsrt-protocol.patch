+/**
+ * @file
+ * QuicSRT (SRT over WebTransport) protocol via libquicsrt
+ *
+ * URL syntax: quicsrt://host:port[?options]
+ *
+ *   stream=NAME          stream name (required)
+ *   cert_hash=HEX        SHA-256 of the gateway cert DER (64 hex chars);
+ *                        pins the certificate the way browsers pin
+ *                        self-signed WebTransport gateways
+ *   cert_hash_file=PATH  read the gateway's runtime cert-hash.js and use
+ *                        its window.CERT_HASH value: "<hex>" pins as
+ *                        cert_hash, null means PKI (same parser as
+ *                        quicsrt-dump; a broken file fails the open)
+ *   pki=1                normal PKI validation (default when no cert
+ *                        parameter is given)
+ *   latency_ms=N         TSBPD latency floor (default 120)
+ *
+ * These parameters are also available as protocol AVOptions,
+ * settable through the options dictionary (e.g. 'ffmpeg -stream
+ * NAME'); a parameter given in the URL query takes precedence over
+ * the option value (http.c convention).
+ *
+ * Direction decides semantics: an OUTPUT (AVIO_FLAG_WRITE) publishes
+ * the stream name toward the gateway; an INPUT subscribes to it. The
+ * same URL works verbatim as ffmpeg output and input.
+ *
+ * The protocol carries MPEG-TS bytes: the library frames them into
+ * 188-aligned SRT live messages of at most 1128 bytes (6 TS packets,
+ * the QuicSRT payload constant). Writes accept any buffer size (a
+ * partial accept resumes from data + returned); reads deliver one
+ * message at a time through an internal bounce buffer, so callers may
+ * use any buffer size >= 1 (ffmpeg's AVIO buffers are far larger than
+ * one message).
+ *
+ * All calls block on the library's session thread; a stalled peer
+ * bounds url_write to 30 s and a dataless url_read to 15 s (defaults;
+ * the generic rw_timeout option overrides both) before failing, so a
+ * dead gateway cannot hang ffmpeg forever. The AVIO interrupt
+ * callback is honored throughout open/read/write, keeping Ctrl+C
+ * responsive even inside those bounds.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/error.h"
+#include "libavutil/file_open.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/parseutils.h"
+#include "libavutil/time.h"
+
+#include "avformat.h"
+#include "url.h"
+#include "urldecode.h"
+
+#include "quicsrt/quicsrt_c.h"
+
+/* QuicSRT payload constant: 6 x 188-byte TS packets (see quicsrt-cpp). */
+#define QUICSRT_PAYLOAD_SIZE 1128
+
+/* Retry window for subscribing to a stream whose publisher has not
+ * registered the name yet (live-edge join during broadcast startup).
+ * Attempts use the library's default connect timeout (10 s) - cutting
+ * it short abandons in-flight QUIC handshakes server-side, which the
+ * local oracle punishes with longer accept stalls. */
+#define QUICSRT_OPEN_RETRY_MS 20000
+#define QUICSRT_OPEN_RETRY_DELAY_US 500000
+
+/* Default stall bounds: publisher writes block under SRT backpressure
+ * (timeout below), reads poll; both get an overall stall bound. The
+ * generic rw_timeout option (microseconds) overrides the two bounds
+ * when set. */
+#define QUICSRT_IO_TIMEOUT_MS 1000
+#define QUICSRT_WRITE_BUDGET_US 30000000
+#define QUICSRT_READ_STALL_US 15000000
+#define QUICSRT_END_TIMEOUT_MS 5000
+
+/* Periodic stats line interval (AV_LOG_DEBUG). */
+#define QUICSRT_STATS_INTERVAL_US 5000000
+
+typedef struct QuicSRTContext {
+    const AVClass        *class;
+    quicsrt_publisher_t  *pub;
+    quicsrt_subscriber_t *sub;
+    int                  is_output;
+
+    /* AVOption-backed parameters. Effective values after the merge in
+     * quicsrt_parse_options: a URL-query parameter overrides the option
+     * value; cert_hash holds the pinned hash (NULL = PKI) once the
+     * optional cert_hash_file has been read. */
+    char                *stream;
+    char                *cert_hash;
+    char                *cert_hash_file;
+    int                  pki;
+    int                  latency_ms;    /* 0 = library default (120) */
+
+    /* Read bounce: one SRT message at a time, served to any caller
+     * buffer size. */
+    uint8_t              bounce[QUICSRT_PAYLOAD_SIZE];
+    int                  bounce_len;
+    int                  bounce_off;
+
+    int64_t              bytes_in;
+    int64_t              bytes_out;
+    int64_t              last_stats_us;
+} QuicSRTContext;
+
+#define D AV_OPT_FLAG_DECODING_PARAM
+#define E AV_OPT_FLAG_ENCODING_PARAM
+#define OFFSET(x) offsetof(QuicSRTContext, x)
+static const AVOption quicsrt_options[] = {
+    { "stream",         "Stream name to publish (output) or subscribe to (input)",   OFFSET(stream),          AV_OPT_TYPE_STRING, { .str = NULL }, 0, 0,        .flags = D|E },
+    { "cert_hash",      "SHA-256 of the gateway cert DER (64 hex chars) to pin",     OFFSET(cert_hash),       AV_OPT_TYPE_STRING, { .str = NULL }, 0, 0,        .flags = D|E },
+    { "cert_hash_file", "cert-hash.js to read the pin (or PKI) from at open",        OFFSET(cert_hash_file),  AV_OPT_TYPE_STRING, { .str = NULL }, 0, 0,        .flags = D|E },
+    { "pki",            "Use normal PKI certificate validation",                     OFFSET(pki),             AV_OPT_TYPE_BOOL,   { .i64 = 0 },    0, 1,        .flags = D|E },
+    { "latency_ms",     "TSBPD latency floor in milliseconds (0 = library default)", OFFSET(latency_ms),      AV_OPT_TYPE_INT,    { .i64 = 0 },    0, 86400000, .flags = D|E },
+    { NULL }
+};
+
+static const AVClass quicsrt_class = {
+    .class_name = "quicsrt",
+    .item_name  = av_default_item_name,
+    .option     = quicsrt_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+static int quicsrt_is_hex_64(const char *s)
+{
+    int i;
+    for (i = 0; i < 64; i++) {
+        if (!av_isxdigit(s[i]))
+            return 0;
+    }
+    return s[64] == '\0';
+}
+
+/* The gateway writes `window.CERT_HASH = "<64 hex>";` (self-signed mode)
+ * or `window.CERT_HASH = null;` (PKI mode) into cert-hash.js. Ported from
+ * quicsrt-dump's parser - strict, so a broken file fails the open instead
+ * of the stream. On success hex_out holds the 64-char hash, or "" when
+ * the file selects PKI. */
+static int quicsrt_read_cert_hash_js(URLContext *h, const char *path,
+                                    char *hex_out)
+{
+    char buf[4096];
+    char *js = NULL;
+    size_t size = 0;
+    const char *key;
+    size_t i;
+    int ret = 0;
+    FILE *f = avpriv_fopen_utf8(path, "rb");
+
+    if (!f) {
+        av_log(h, AV_LOG_ERROR, "cert_hash_file: cannot open '%s'\n", path);
+        return AVERROR(EIO);
+    }
+    for (;;) {
+        size_t n = fread(buf, 1, sizeof(buf), f);
+        if (n > 0) {
+            char *grown;
+            if (size > 65536) {
+                av_log(h, AV_LOG_ERROR, "cert_hash_file: '%s' is not a cert-hash.js\n", path);
+                ret = AVERROR(EINVAL);
+                goto out;
+            }
+            grown = av_realloc(js, size + n);
+            if (!grown) {
+                ret = AVERROR(ENOMEM);
+                goto out;
+            }
+            js = grown;
+            memcpy(js + size, buf, n);
+            size += n;
+        }
+        if (n < sizeof(buf))
+            break; /* short read: EOF unless ferror() flags an error */
+    }
+    if (ferror(f)) {
+        av_log(h, AV_LOG_ERROR, "cert_hash_file: read error on '%s'\n", path);
+        ret = AVERROR(EIO);
+        goto out;
+    }
+
+    key = size ? av_strnstr(js, "CERT_HASH", size) : NULL;
+    if (!key) {
+        av_log(h, AV_LOG_ERROR, "cert_hash_file: no CERT_HASH in '%s'\n", path);
+        ret = AVERROR(EINVAL);
+        goto out;
+    }
+    i = key - js + strlen("CERT_HASH");
+    while (i < size && js[i] && strchr(" \t\r\n", js[i]))
+        i++;
+    if (i >= size || js[i] != '=') {
+        av_log(h, AV_LOG_ERROR, "cert_hash_file: malformed CERT_HASH assignment\n");
+        ret = AVERROR(EINVAL);
+        goto out;
+    }
+    i++;
+    while (i < size && js[i] && strchr(" \t\r\n", js[i]))
+        i++;
+    if (i + 4 <= size && !strncmp(js + i, "null", 4)) {
+        hex_out[0] = '\0'; /* the file selects PKI */
+    } else {
+        if (i >= size || js[i] != '"' || i + 1 + 64 >= size ||
+            js[i + 1 + 64] != '"') {
+            av_log(h, AV_LOG_ERROR, "cert_hash_file: CERT_HASH is neither null nor a quoted 64-char hash\n");
+            ret = AVERROR(EINVAL);
+            goto out;
+        }
+        memcpy(hex_out, js + i + 1, 64);
+        hex_out[64] = '\0';
+        if (!quicsrt_is_hex_64(hex_out)) {
+            av_log(h, AV_LOG_ERROR, "cert_hash_file: CERT_HASH value is not 64 hex characters\n");
+            ret = AVERROR(EINVAL);
+            goto out;
+        }
+    }
+out:
+    av_free(js);
+    fclose(f);
+    return ret;
+}
+
+/* Percent-decode a URL query parameter value into *out (av_malloc'd).
+ * A '%' not followed by two hex digits fails the open instead of
+ * passing through silently, so a mistyped escape cannot name a wrong
+ * file or stream. '+' decodes to ' ', matching how query parameter
+ * values are decoded throughout (decode_plus_sign = 1, as in
+ * ff_parse_opts_from_query_string in utils.c). */
+static int quicsrt_decode_param(URLContext *h, const char *value,
+                               const char *param, char **out)
+{
+    const char *q;
+
+    for (q = value; *q; q++) {
+        if (q[0] == '%' && !(av_isxdigit(q[1]) && av_isxdigit(q[2]))) {
+            av_log(h, AV_LOG_ERROR,
+                   "invalid percent-encoding in %s\n", param);
+            return AVERROR(EINVAL);
+        }
+    }
+    /* Only OOM can fail here: escapes were validated above. */
+    *out = ff_urldecode(value, 1);
+    if (!*out)
+        return AVERROR(ENOMEM);
+    return 0;
+}
+
+static int quicsrt_parse_options(URLContext *h, const char *uri,
+                                char *host, int host_size, int *port,
+                                QuicSRTContext *s)
+{
+    const char *cert_mode[3];
+    const char *p;
+    char buf[1024];
+    char hash[2 * 32 + 1];
+    int url_cert_hash = 0, url_cert_hash_file = 0, url_pki = 0;
+    int ncert = 0;
+    int ret;
+
+    av_url_split(NULL, 0, NULL, 0, host, host_size, port, NULL, 0, uri);
+    if (!host[0]) {
+        av_log(h, AV_LOG_ERROR, "host missing in '%s'\n", uri);
+        return AVERROR(EINVAL);
+    }
+    if (*port < 0)
+        *port = 443; /* the QuicSRT gateway default */
+
+    /* Merge rule (http.c convention, cf. ff_parse_opts_from_query_string
+     * in udp.c/tcp.c: dict options are applied first, URL parameters
+     * parsed afterwards override them): a parameter found in the URL
+     * query wins, otherwise the AVOption value set through the options
+     * dictionary applies. */
+    p = strchr(uri, '?');
+    if (!p && !(s->stream && s->stream[0])) {
+        av_log(h, AV_LOG_ERROR, "no options: stream name required (%s)\n", uri);
+        return AVERROR(EINVAL);
+    }
+    if (p) {
+        if (av_find_info_tag(buf, sizeof(buf), "stream", p)) {
+            char *val;
+            ret = quicsrt_decode_param(h, buf, "stream", &val);
+            if (ret < 0)
+                return ret;
+            av_freep(&s->stream);
+            s->stream = val;
+        }
+        if (av_find_info_tag(buf, sizeof(buf), "cert_hash", p)) {
+            char *val;
+            ret = quicsrt_decode_param(h, buf, "cert_hash", &val);
+            if (ret < 0)
+                return ret;
+            if (!quicsrt_is_hex_64(val)) {
+                av_log(h, AV_LOG_ERROR, "cert_hash must be 64 hex characters\n");
+                av_free(val);
+                return AVERROR(EINVAL);
+            }
+            av_freep(&s->cert_hash);
+            s->cert_hash = val;
+            url_cert_hash = 1;
+        }
+        if (av_find_info_tag(buf, sizeof(buf), "cert_hash_file", p)) {
+            char *val;
+            ret = quicsrt_decode_param(h, buf, "cert_hash_file", &val);
+            if (ret < 0)
+                return ret;
+            av_freep(&s->cert_hash_file);
+            s->cert_hash_file = val;
+            url_cert_hash_file = 1;
+        }
+        if (av_find_info_tag(buf, sizeof(buf), "pki", p)) {
+            if (strcmp(buf, "1")) {
+                av_log(h, AV_LOG_ERROR, "pki must be 1\n");
+                return AVERROR(EINVAL);
+            }
+            url_pki = 1;
+        }
+        if (av_find_info_tag(buf, sizeof(buf), "latency_ms", p)) {
+            char *end;
+            long latency = strtol(buf, &end, 10);
+            if (*end != '\0' || latency <= 0 || latency > 86400000) {
+                av_log(h, AV_LOG_ERROR, "latency_ms must be a positive integer <= 86400000\n");
+                return AVERROR(EINVAL);
+            }
+            s->latency_ms = (int)latency;
+        }
+    }
+
+    /* cert_hash, cert_hash_file and pki are mutually exclusive across
+     * the URL query and the options dictionary combined (the same
+     * parameter in both sources is fine: the URL value wins). */
+    if (url_cert_hash)
+        cert_mode[ncert++] = "cert_hash (URL)";
+    else if (s->cert_hash)
+        cert_mode[ncert++] = "cert_hash (option)";
+    if (url_cert_hash_file)
+        cert_mode[ncert++] = "cert_hash_file (URL)";
+    else if (s->cert_hash_file)
+        cert_mode[ncert++] = "cert_hash_file (option)";
+    if (url_pki)
+        cert_mode[ncert++] = "pki (URL)";
+    else if (s->pki)
+        cert_mode[ncert++] = "pki (option)";
+    if (ncert > 1) {
+        av_log(h, AV_LOG_ERROR,
+               "%s conflicts with %s: cert_hash, cert_hash_file and "
+               "pki are mutually exclusive\n",
+               cert_mode[0], cert_mode[1]);
+        return AVERROR(EINVAL);
+    }
+
+    if (s->cert_hash && !url_cert_hash &&
+        !quicsrt_is_hex_64(s->cert_hash)) {
+        av_log(h, AV_LOG_ERROR, "cert_hash must be 64 hex characters\n");
+        return AVERROR(EINVAL);
+    }
+    if (s->cert_hash_file) {
+        /* cert_hash is NULL here: the exclusion above ran first. An
+         * empty result means the file selects PKI. */
+        ret = quicsrt_read_cert_hash_js(h, s->cert_hash_file, hash);
+        if (ret < 0)
+            return ret;
+        if (hash[0]) {
+            s->cert_hash = av_strdup(hash);
+            if (!s->cert_hash)
+                return AVERROR(ENOMEM);
+        }
+    }
+
+    if (!s->stream || !s->stream[0]) {
+        av_log(h, AV_LOG_ERROR, "stream name required (?stream=NAME)\n");
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+static void quicsrt_log_stats(URLContext *h, QuicSRTContext *s, int force)
+{
+    int64_t now = av_gettime();
+    char stats[512];
+
+    if (!force && now - s->last_stats_us < QUICSRT_STATS_INTERVAL_US)
+        return;
+    s->last_stats_us = now;
+
+    if (s->is_output) {
+        if (quicsrt_publisher_stats(s->pub, stats, sizeof(stats)) == QUICSRT_OK)
+            av_log(h, AV_LOG_DEBUG, "stats: %s\n", stats);
+    } else {
+        if (quicsrt_subscriber_stats(s->sub, stats, sizeof(stats)) == QUICSRT_OK)
+            av_log(h, AV_LOG_DEBUG, "stats: %s\n", stats);
+    }
+}
+
+static int quicsrt_open(URLContext *h, const char *uri, int flags)
+{
+    QuicSRTContext *s = h->priv_data;
+    char host[1024];
+    int port, ret;
+    quicsrt_status_t st;
+
+    h->is_streamed = 1;
+    s->is_output   = (flags & AVIO_FLAG_WRITE) != 0;
+
+    ret = quicsrt_parse_options(h, uri, host, sizeof(host), &port, s);
+    if (ret < 0)
+        return ret;
+
+    if (s->is_output) {
+        /* Direction decides semantics: output publishes the name. One
+         * retry after a transport-level stall: the gateway's accept
+         * loop can starve transiently under churn (self-healing). */
+        int attempt;
+        for (attempt = 0;; attempt++) {
+            s->pub = quicsrt_publisher_create();
+            if (!s->pub) {
+                ret = AVERROR(ENOMEM);
+                goto fail;
+            }
+            st = quicsrt_publisher_start(s->pub, host, port, s->stream,
+                                        s->cert_hash,
+                                        s->latency_ms, 0);
+            if (st == QUICSRT_OK)
+                break;
+            if ((st == QUICSRT_ETIMEOUT || st == QUICSRT_ECONNECT) && attempt == 0) {
+                int slept;
+                av_log(h, AV_LOG_WARNING, "publish start stalled (%s); retrying in 3 s\n",
+                       quicsrt_publisher_last_error(s->pub));
+                quicsrt_publisher_destroy(s->pub);
+                s->pub = NULL;
+                /* Chunked so an interrupt stays responsive. */
+                for (slept = 0; slept < 3000000; slept += 100000) {
+                    if (ff_check_interrupt(&h->interrupt_callback)) {
+                        ret = AVERROR_EXIT;
+                        goto fail;
+                    }
+                    av_usleep(100000);
+                }
+                continue;
+            }
+            if (st == QUICSRT_EREJECTED) {
+                av_log(h, AV_LOG_ERROR, "stream name in use: '%s' is held by a live source\n", s->stream);
+                ret = AVERROR(EADDRINUSE);
+            } else if (st == QUICSRT_ETIMEOUT) {
+                ret = AVERROR(ETIMEDOUT);
+            } else {
+                ret = AVERROR(EIO);
+            }
+            av_log(h, AV_LOG_ERROR, "publish start failed: %s\n",
+                   quicsrt_publisher_last_error(s->pub));
+            goto fail;
+        }
+        av_log(h, AV_LOG_INFO, "publishing '%s' to %s:%d (%s)\n",
+               s->stream, host, port, s->cert_hash ? "cert pinned" : "PKI");
+    } else {
+        /* Input subscribes; retry while the gateway answers 404 so a
+         * live-edge join during broadcast startup succeeds, and ride
+         * out transient transport stalls the same way - but a stream
+         * that never appears fails within the retry window. */
+        int64_t deadline = av_gettime() + QUICSRT_OPEN_RETRY_MS * 1000LL;
+        for (;;) {
+            if (ff_check_interrupt(&h->interrupt_callback)) {
+                ret = AVERROR_EXIT;
+                goto fail;
+            }
+            s->sub = quicsrt_subscriber_create();
+            if (!s->sub) {
+                ret = AVERROR(ENOMEM);
+                goto fail;
+            }
+            st = quicsrt_subscriber_start(s->sub, host, port, s->stream,
+                                         s->cert_hash,
+                                         s->latency_ms, 0);
+            if (st == QUICSRT_OK)
+                break;
+            if (st == QUICSRT_EREJECTED || st == QUICSRT_ETIMEOUT || st == QUICSRT_ECONNECT) {
+                quicsrt_subscriber_destroy(s->sub);
+                s->sub = NULL;
+                if (av_gettime() >= deadline) {
+                    av_log(h, AV_LOG_ERROR, "stream '%s' not available: %s\n",
+                           s->stream, st == QUICSRT_EREJECTED
+                                      ? "no publisher (HTTP 404)" : "gateway unreachable");
+                    ret = AVERROR(ECONNREFUSED);
+                    goto fail;
+                }
+                if (ff_check_interrupt(&h->interrupt_callback)) {
+                    ret = AVERROR_EXIT;
+                    goto fail;
+                }
+                av_usleep(QUICSRT_OPEN_RETRY_DELAY_US);
+                continue;
+            }
+            av_log(h, AV_LOG_ERROR, "subscribe start failed: %s\n",
+                   quicsrt_subscriber_last_error(s->sub));
+            ret = st == QUICSRT_ETIMEOUT ? AVERROR(ETIMEDOUT) : AVERROR(EIO);
+            goto fail;
+        }
+        av_log(h, AV_LOG_INFO, "subscribed to '%s' at %s:%d (%s)\n",
+               s->stream, host, port, s->cert_hash ? "cert pinned" : "PKI");
+    }
+    s->last_stats_us = av_gettime();
+    return 0;
+
+fail:
+    if (s->pub) {
+        quicsrt_publisher_destroy(s->pub);
+        s->pub = NULL;
+    }
+    if (s->sub) {
+        quicsrt_subscriber_destroy(s->sub);
+        s->sub = NULL;
+    }
+    return ret;
+}
+
+static int quicsrt_read(URLContext *h, uint8_t *buf, int size)
+{
+    QuicSRTContext *s = h->priv_data;
+    int64_t stall_us = h->rw_timeout > 0 ? h->rw_timeout
+                                         : QUICSRT_READ_STALL_US;
+    int64_t stall_deadline = av_gettime() + stall_us;
+
+    /* Serve a short read from the bounce buffer first. */
+    if (s->bounce_off < s->bounce_len) {
+        int n = FFMIN(size, s->bounce_len - s->bounce_off);
+        memcpy(buf, s->bounce + s->bounce_off, n);
+        s->bounce_off += n;
+        if (s->bounce_off == s->bounce_len)
+            s->bounce_off = s->bounce_len = 0;
+        s->bytes_in += n;
+        quicsrt_log_stats(h, s, 0);
+        return n;
+    }
+
+    for (;;) {
+        int n, timeout_ms;
+        int64_t left_us;
+
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+        /* Bound each poll by the remaining stall budget so a small
+         * rw_timeout is not overshot by the 1 s poll granularity. */
+        left_us    = stall_deadline - av_gettime();
+        timeout_ms = (int)FFMIN(QUICSRT_IO_TIMEOUT_MS, left_us / 1000);
+        timeout_ms = FFMAX(timeout_ms, 1);
+        n = quicsrt_subscriber_read(s->sub, s->bounce, sizeof(s->bounce),
+                                   timeout_ms);
+        if (n > 0) {
+            int m = FFMIN(size, n);
+            memcpy(buf, s->bounce, m);
+            s->bounce_len = n;
+            s->bounce_off = m;
+            s->bytes_in  += m;
+            quicsrt_log_stats(h, s, 0);
+            return m;
+        }
+        switch (n) {
+        case QUICSRT_READ_TIMEOUT:
+            if (av_gettime() >= stall_deadline) {
+                av_log(h, AV_LOG_ERROR, "no data for %d ms\n",
+                       (int)(stall_us / 1000));
+                return AVERROR(ETIMEDOUT);
+            }
+            continue;
+        case QUICSRT_READ_END:
+            return AVERROR_EOF;
+        case QUICSRT_READ_CLOSED:
+            av_log(h, AV_LOG_ERROR, "session closed: %s\n",
+                   quicsrt_subscriber_last_error(s->sub));
+            return AVERROR(ECONNRESET);
+        default:
+            av_log(h, AV_LOG_ERROR, "read failed: %s\n",
+                   quicsrt_subscriber_last_error(s->sub));
+            return AVERROR(EIO);
+        }
+    }
+}
+
+static int quicsrt_write(URLContext *h, const uint8_t *buf, int size)
+{
+    QuicSRTContext *s = h->priv_data;
+    const uint8_t *data = buf;
+    int left = size;
+    int64_t budget_us = h->rw_timeout > 0 ? h->rw_timeout
+                                          : QUICSRT_WRITE_BUDGET_US;
+    int64_t budget_deadline = av_gettime() + budget_us;
+
+    while (left > 0) {
+        int n, timeout_ms;
+        int64_t left_us;
+
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+        /* Bound each write attempt by the remaining budget so a small
+         * rw_timeout is not overshot by the 1 s granularity. */
+        left_us    = budget_deadline - av_gettime();
+        timeout_ms = (int)FFMIN(QUICSRT_IO_TIMEOUT_MS, left_us / 1000);
+        timeout_ms = FFMAX(timeout_ms, 1);
+        n = quicsrt_publisher_write(s->pub, data, left, timeout_ms);
+        if (n > 0) {
+            /* Partial accept: resume from data + returned. */
+            data += n;
+            left -= n;
+            s->bytes_out += n;
+            quicsrt_log_stats(h, s, 0);
+            continue;
+        }
+        switch (n) {
+        case QUICSRT_WRITE_TIMEOUT:
+            if (av_gettime() >= budget_deadline) {
+                av_log(h, AV_LOG_ERROR, "write stalled for %d ms (backpressure)\n",
+                       (int)(budget_us / 1000));
+                return AVERROR(ETIMEDOUT);
+            }
+            continue;
+        case QUICSRT_WRITE_CLOSED:
+            av_log(h, AV_LOG_ERROR, "session closed: %s\n",
+                   quicsrt_publisher_last_error(s->pub));
+            return AVERROR(EPIPE);
+        default:
+            av_log(h, AV_LOG_ERROR, "write failed: %s\n",
+                   quicsrt_publisher_last_error(s->pub));
+            return AVERROR(EIO);
+        }
+    }
+    return size;
+}
+
+static int quicsrt_close(URLContext *h)
+{
+    QuicSRTContext *s = h->priv_data;
+
+    if (s->pub) {
+        quicsrt_status_t st = quicsrt_publisher_end(s->pub, QUICSRT_END_TIMEOUT_MS);
+        if (st != QUICSRT_OK) {
+            av_log(h, AV_LOG_WARNING, "graceful end failed (%s); dropping tail\n",
+                   quicsrt_publisher_last_error(s->pub));
+            quicsrt_publisher_stop(s->pub);
+        }
+        quicsrt_log_stats(h, s, 1);
+        av_log(h, AV_LOG_INFO, "stopped publishing: %lld bytes written\n",
+               (long long)s->bytes_out);
+        quicsrt_publisher_destroy(s->pub);
+        s->pub = NULL;
+    }
+    if (s->sub) {
+        quicsrt_log_stats(h, s, 1);
+        av_log(h, AV_LOG_INFO, "stopped subscribing: %lld bytes read\n",
+               (long long)s->bytes_in);
+        quicsrt_subscriber_destroy(s->sub);
+        s->sub = NULL;
+    }
+    av_freep(&s->stream);
+    av_freep(&s->cert_hash);
+    av_freep(&s->cert_hash_file);
+    return 0;
+}
+
+const URLProtocol ff_quicsrt_protocol = {
+    .name                = "quicsrt",
+    .url_open            = quicsrt_open,
+    .url_read            = quicsrt_read,
+    .url_write           = quicsrt_write,
+    .url_close           = quicsrt_close,
+    .priv_data_size      = sizeof(QuicSRTContext),
+    .flags               = URL_PROTOCOL_FLAG_NETWORK,
+    .priv_data_class     = &quicsrt_class,
+};
