prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: websrt
Description: WebSRT client library (SRT over WebTransport)
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lwebsrt @WEBSRT_PC_LIBS@ @WEBSRT_PC_EXTRA@
Libs.private: @WEBSRT_PC_LIBS@
