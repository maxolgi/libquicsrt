prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: quicsrt
Description: QuicSRT client library (SRT over WebTransport)
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lquicsrt @QUICSRT_PC_LIBS@ @QUICSRT_PC_EXTRA@
Libs.private: @QUICSRT_PC_LIBS@
